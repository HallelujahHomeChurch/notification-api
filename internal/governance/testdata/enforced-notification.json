      "evidence": [
        {"kind": "go_test", "path": "internal/retention/worker_test.go", "test_name": "TestRunOnceUsesRequiredRetentionWindowsAndBoundedBatch"},
        {"kind": "go_test", "path": "internal/retention/worker_integration_test.go", "test_name": "TestRetentionPreservesRecentAndNonterminalPayloadsOnRepeat"}
      ]
    }
  }]
