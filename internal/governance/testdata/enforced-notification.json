        "source": {"path": "internal/retention/worker.go", "symbol": "postgresRepository.retain"},
        "duration_source": null,
        "predicate": "expires_at <= now",
        "description": "Fixture references the existing rate-limit expiry cleanup."
      },
      "action": "expire"
    },
    "cleanup": {
      "mode": "existing_worker",
