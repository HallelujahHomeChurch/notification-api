PORT=8081
INTERNAL_API_TOKEN=

# Local default: no Azure dependency. Use servicebus in production.
QUEUE_DRIVER=memory
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=notifications-email

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
EMAIL_COOLDOWN=15m
EMAIL_RECIPIENT_DAILY_LIMIT=5
EMAIL_GLOBAL_DAILY_LIMIT=1000
NOTIFICATIONS_DISABLED=false

# Empty SMTP_ADDR logs emails instead of sending.
SMTP_ADDR=
# Local development only. Prints verification/reset links (and their tokens) to stdout.
LOG_EMAIL_BODY=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
