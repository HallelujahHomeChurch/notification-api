ENVIRONMENT=development
PORT=8081
DATABASE_URL=
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m

# Comma-separated Dapr app IDs. Required in production.
NOTIFICATION_ALLOWED_CALLERS=account-api,hhc-web-api,engagement-api
# Development-only fallback for local HTTP tests. Production must remain false.
NOTIFICATION_ALLOW_DEV_CALLER_HEADER=false
# Legacy single-key fallback. Keep during the expand rollout.
# Base64-encoded, exactly 32 decoded bytes.
NOTIFICATION_DATA_ENCRYPTION_KEY=
# Versioned encryption keyring. JSON values are base64-encoded 32-byte keys.
NOTIFICATION_ACTIVE_ENCRYPTION_KEY_ID=
NOTIFICATION_ENCRYPTION_KEYS_JSON=
# Legacy single-key fallback. Keep during the expand rollout.
# At least 32 bytes of secret material.
NOTIFICATION_HASH_KEY=
# Versioned hash keyring. JSON values contain at least 32 bytes of secret material.
NOTIFICATION_ACTIVE_HASH_KEY_ID=
NOTIFICATION_HASH_KEYS_JSON=

# Connection strings are development-only. Production uses Service Bus managed identity.
QUEUE_DRIVER=servicebus
SERVICEBUS_NAMESPACE=
SERVICEBUS_QUEUE_NAME=notifications-email
SERVICEBUS_CONNECTION_STRING=

SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=哈利路亞家教會
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@alive.org.tw
NOTIFICATIONS_DISABLED=false
SHUTDOWN_TIMEOUT_SECONDS=30

# Shared across SMTP worker replicas; minute ceiling is conservative, not an ACS quota claim.
SMTP_EMAILS_PER_MINUTE=20
SMTP_EMAILS_PER_HOUR=100
SMTP_TRANSACTIONAL_RESERVE_PER_MINUTE=5
SMTP_TRANSACTIONAL_RESERVE_PER_HOUR=20

# In-app inbox remains off until both authenticated business visibility owners are deployed.
NOTIFICATION_INBOX_ENABLED=false
NOTIFICATION_INBOX_OPERATIONS_VISIBILITY_URL=
NOTIFICATION_INBOX_WEBSITE_VISIBILITY_URL=
